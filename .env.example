PAYLOAD_SECRET=replace-with-32-char-random-string
DATABASE_URI=file:./imperiya.db
# Local dev: http://localhost:3000 — production (Vercel): https://www.imperiya.uz
# Drives canonical URLs, sitemap.xml, robots and absolute Open Graph links.
# A localhost value is ignored in production builds (see lib/site.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Search console verification (production only, optional) ---
# Paste ONLY the token, not the whole <meta> tag. The tag is omitted
# when the variable is unset, so leave these empty for local dev.
# Google Search Console → Settings → Ownership verification → HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Яндекс.Вебмастер → Настройки → Права доступа → Мета-тег
NEXT_PUBLIC_YANDEX_VERIFICATION=

# --- Analytics (production only, optional) ---
# Yandex Metrica counter number, digits only (metrika.yandex.ru → Настройки
# → Номер счётчика). Leave empty locally: nothing is injected without it,
# so dev and preview traffic stays out of the production stats.
NEXT_PUBLIC_YANDEX_METRICA_ID=
# Session recording. OFF by default: it captures what visitors type, and
# the calculator collects phone numbers. Before setting this to "true",
# mark those fields so Metrica masks them (class="ym-hide-content").
NEXT_PUBLIC_YANDEX_METRICA_WEBVISOR=

# --- Calculator leads → Telegram (required in production) ---
# Server-side only: NEVER add a NEXT_PUBLIC_ prefix here, or the bot token
# ends up in the browser bundle and anyone can post as the bot.
# Token: @BotFather → /newbot.
TELEGRAM_BOT_TOKEN=
# Where the leads land. Add the bot to the managers' group, send any message
# there, then open https://api.telegram.org/bot<TOKEN>/getUpdates and take
# result[].message.chat.id (group ids are negative, e.g. -1001234567890).
# Comma-separated for several recipients: -1001234567890,123456789
TELEGRAM_CHAT_ID=
